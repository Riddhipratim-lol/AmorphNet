# ==============================================================================
# AmorphNet Environment Configuration
# All AI services and datastores run entirely on managed cloud APIs.
# ==============================================================================

# LlamaParse Cloud API (v2 multimodal PDF parsing)
LLAMA_CLOUD_API_KEY=llx-your-llamaparse-key-here

# Voyage AI (voyage-4-large embeddings and rerank-2.5 reranker)
VOYAGE_API_KEY=pa-your-voyage-api-key-here

# Qdrant Cloud (Managed Vector + Native BM25 Sparse Search)
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_COLLECTION=financial_chunks

# Neo4j AuraDB (Managed Document Knowledge Graph)
NEO4J_URI=neo4j+s://your-db-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password-here

# Google AI (Gemini 3.5 Flash-Lite generation and structured parsing)
GOOGLE_API_KEY=AIzaSy-your-google-api-key-here

# Upstash Redis (Serverless cloud cache, rate limit store, and job state)
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here
# Optional standard Redis connection string (if using redis-py directly)
# REDIS_URL=rediss://default:your-token@your-database.upstash.io:6379

# Application & Concurrency Controls
LOG_LEVEL=INFO
MAX_CONCURRENT_INGESTIONS=3
QUERY_TIMEOUT_SECONDS=30
CACHE_TTL_SECONDS=3600

# Rate Limiting & Quota Controls
LLAMAPARSE_MAX_CONCURRENCY=3
VOYAGE_MAX_RETRIES=5
GEMINI_RPM_LIMIT=14
EVAL_MODE=smoke
